{
  "expo": {
    "name": "RETFAST",
    "slug": "retfast",
    "description": "Live tracking and retrieval coordination for outdoor events.",
    "version": "0.1.0",
    "scheme": "retfast",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F4F7F5",
    "primaryColor": "#126B5B",
    "ios": {
      "bundleIdentifier": "com.mizibu.retfast",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "supportsTablet": true
    },
    "android": {
      "package": "com.mizibu.retfast",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0D3F35",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-notifications",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "RETFAST, aktif göreviniz boyunca konumunuzu paylaşabilmek için konum erişimini kullanır. RETFAST uses your location during an active mission.",
          "locationWhenInUsePermission": "RETFAST haritada konumunuzu göstermek için konum erişimini kullanır. RETFAST uses your location to show you on the map.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ]
  }
}
