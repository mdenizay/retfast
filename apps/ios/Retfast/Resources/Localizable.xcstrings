    "GPX dosyası telefondaki ham GPS noktalarından oluşturulur. Sertifikalı bir uçuş kaydı (IGC) değildir ve yarışma/rekor kanıtı olarak kullanılamaz." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The GPX file is built from the raw GPS points on this phone. It is not a certified flight log (IGC) and cannot be used as competition or record evidence."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPX dosyası telefondaki ham GPS noktalarından oluşturulur. Sertifikalı bir uçuş kaydı (IGC) değildir ve yarışma/rekor kanıtı olarak kullanılamaz."
          }
        }
      }
    },
    "GPX dosyası telefondaki ham GPS noktalarından oluşturulur. Sertifikalı bir uçuş kaydı değildir (not a certified flight log); yarışma/rekor kanıtı olarak kullanılamaz." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The GPX file is built from the phone's raw GPS points. It is not a certified flight log and can't be used as competition or record evidence."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPX dosyası telefondaki ham GPS noktalarından oluşturulur. Sertifikalı bir uçuş kaydı değildir (not a certified flight log); yarışma/rekor kanıtı olarak kullanılamaz."
          }
        }
      }
    },
