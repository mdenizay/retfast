    },
    "Kayıt duraklatıldı. GPS kapalı; bu sürede konum kaydedilmez ve canlı haritada güncellenmezsiniz.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording paused. GPS is off; no positions are recorded and you are not updated on the live map."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt duraklatıldı. GPS kapalı; bu sürede konum kaydedilmez ve canlı haritada güncellenmezsiniz."
          }
        }
      }
    },
    "Kayıt durdurulur. Gönderilmemiş noktalar bağlantı gelince gönderilmeye devam eder.": {
