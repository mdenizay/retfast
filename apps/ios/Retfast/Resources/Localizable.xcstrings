    "Bu çağrı Retfast kurtarma ekibine internet üzerinden iletilir. 112'yi veya yetkilileri otomatik aramaz.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This call is sent to the Retfast rescue team over the internet. It does not automatically call 112 or the authorities."
          }
