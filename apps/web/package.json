{
  "name": "@retfast/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "copy-assets": "bun -e \"const fs=require('fs'),path=require('path');const dist=path.join(path.dirname(require.resolve('maplibre-gl/package.json')),'dist');fs.mkdirSync('public/maplibre',{recursive:true});for(const f of ['maplibre-gl.mjs','maplibre-gl-worker.mjs'])fs.copyFileSync(path.join(dist,f),path.join('public/maplibre',f))\"",
    "predev": "bun run copy-assets",
    "prebuild": "bun run copy-assets"
  },
  "dependencies": {
    "@retfast/core": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.55.0",
    "maplibre-gl": "^6.13.0",
    "next": "^16.4.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
