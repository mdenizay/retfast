{
  "expo": {
    "name": "Retfast",
    "slug": "retfast",
    "scheme": "retfast",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "locales": {
      "en": "./locales/en.json",
      "tr": "./locales/tr.json"
    },
    "ios": {
      "bundleIdentifier": "com.mizibu.retfast",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      "@maplibre/maplibre-react-native",
      "./plugins/with-ios-scenes"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
