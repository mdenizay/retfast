    "Kayıt %@ sonrasında kesildi (uygulama kapatıldı veya iOS sonlandırdı) ve yeniden başlatıldı. Aradaki süre izde boşluk olarak görünür." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recording was interrupted after %@ (the app was closed or iOS terminated it) and has restarted. The time in between appears as a gap in the track."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıt %@ sonrasında kesildi (uygulama kapatıldı veya iOS sonlandırdı) ve yeniden başlatıldı. Aradaki süre izde boşluk olarak görünür."
          }
        }
      }
    },
    "Kayıt %@ sonrasında kesildi ve yeniden başladı. Aradaki süre izde boşluk olarak görünür." : {
      "localizations" : {
