    "Bu etkinlikte canlı takip kapalı. Uçuş kişisel olarak kaydedilir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live tracking is off for this event. The flight is recorded as personal."
