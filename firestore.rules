rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return signedIn() && request.auth.token.superadmin == true;
    }

    function validOwnProfile(userId) {
      return request.resource.data.id == userId
        && request.resource.data.globalRole == 'user'
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.locale in ['tr', 'en']
        && (request.resource.data.radioCallsign == null
          || request.resource.data.radioCallsign is string);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'id',
          'email',
          'displayName',
          'locale',
          'globalRole',
          'radioCallsign',
          'createdAt',
          'updatedAt'
        ])
        && validOwnProfile(userId);

      allow update: if isSuperAdmin()
        || (isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName',
            'locale',
            'radioCallsign',
            'updatedAt'
          ])
          && request.resource.data.id == resource.data.id
          && request.resource.data.email == resource.data.email
          && request.resource.data.globalRole == resource.data.globalRole
          && validOwnProfile(userId));

      allow delete: if isOwner(userId) || isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
