        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum izni henüz verilmedi."
          }
        }
      }
    },
    "Konum izni kaldırıldı. Kayıt konum alamıyor; Ayarlar'dan izni geri verin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location permission was removed. Recording gets no positions; restore it in Settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum izni kaldırıldı. Kayıt konum alamıyor; Ayarlar'dan izni geri verin."
