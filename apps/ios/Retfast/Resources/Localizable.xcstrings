    "Konum henüz yok. Çağrı konumsuz gönderilir; sunucu son kaydedilen uçuş konumunuzu kullanabilir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No position yet. The call is sent without a position; the server may use your last recorded flight position."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum henüz yok. Çağrı konumsuz gönderilir; sunucu son kaydedilen uçuş konumunuzu kullanabilir."
          }
        }
      }
    },
    "Konum izni": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location permission"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum izni"
          }
        }
      }
    },
    "Konum izni \"Her Zaman\" değil. Uçuş öncesi kontrolde ayrıntıları görün.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location permission is not \"Always\". See the pre-flight check for details."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum izni \"Her Zaman\" değil. Uçuş öncesi kontrolde ayrıntıları görün."
          }
        }
      }
    },
    "Konum izni henüz verilmedi.": {
      "localizations": {
