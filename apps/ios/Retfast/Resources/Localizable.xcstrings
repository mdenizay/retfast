    "Bu bilgiler yalnızca acil durum çağrısı açtığınızda yetkili kurtarma ekibine gösterilir; herkese açık profilde asla görünmez.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is shown only to the authorised rescue team when you open an emergency call; it never appears on your public profile."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bilgiler yalnızca acil durum çağrısı açtığınızda yetkili kurtarma ekibine gösterilir; herkese açık profilde asla görünmez."
          }
        }
      }
    },
    "Bu bir TEST çağrısıdır, gerçek acil durum değildir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a TEST call, not a real emergency."
