# Yerel geliştirme. Gerçek anahtarları buraya değil, git dışı .env dosyasına yaz.
DATABASE_URL=postgres://retfast:retfast@localhost/retfast_dev
REDIS_URL=redis://127.0.0.1:6379
BIND=127.0.0.1:3001
COOKIE_SECURE=false
PUBLIC_WEB_URL=http://localhost:3000
# Ayrı origin'den erişen web için (tek origin kurulumda boş bırak)
CORS_ORIGINS=http://localhost:3000
# Boşsa e-postalar gönderilmez, loglanır
RESEND_API_KEY=
MAIL_FROM="Retfast <no-reply@retfast.com>"
# LOG_FORMAT=json
