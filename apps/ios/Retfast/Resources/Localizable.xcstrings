    "Arka plan kaydı sınırlı olabilir. Uygulamayı kaydırarak kapatmayın; kapatırsanız iOS konum vermeyi durdurur.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background recording may be limited. Don't swipe the app away; if you do, iOS stops delivering location."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka plan kaydı sınırlı olabilir. Uygulamayı kaydırarak kapatmayın; kapatırsanız iOS konum vermeyi durdurur."
