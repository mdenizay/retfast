          }
        }
      }
    },
    "Her uçuş için görünürlüğü siz seçersiniz: yalnızca ben, organizasyon veya herkese açık. Acil durum çağrısı açtığınızda yetkili kurtarma ekibi son konumunuzu ve acil durum kişinizi görebilir." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You choose the visibility of every flight: only me, the event, or public. When you open an emergency call, the authorised rescue team can see your last position and your emergency contact."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her uçuş için görünürlüğü siz seçersiniz: yalnızca ben, organizasyon veya herkese açık. Acil durum çağrısı açtığınızda yetkili kurtarma ekibi son konumunuzu ve acil durum kişinizi görebilir."
          }
        }
      }
    },
    "Her uçuştan önce değiştirebilirsiniz. Acil durum çağrısında yetkili kurtarma ekibi görünürlükten bağımsız olarak konumunuzu görür." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can change it before every flight. During an emergency call the authorised rescue team sees your position regardless of visibility."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her uçuştan önce değiştirebilirsiniz. Acil durum çağrısında yetkili kurtarma ekibi görünürlükten bağımsız olarak konumunuzu görür."
          }
        }
      }
    },
    "Her zaman" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Always"
          }
