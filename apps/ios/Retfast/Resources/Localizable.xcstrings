    "Henüz kimse çağrınızı onaylamadı. Mümkünse 112'yi arayın ve güvende kalın.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody has acknowledged your call yet. If you can, call 112 and stay safe."
          }
        },
        "tr": {
          "stringUnit": {
