    "Talep önce telefona kaydedilir; bağlantı yoksa bağlantı gelince otomatik gönderilir. Retfast bir acil durum servisi değildir: acil durumda 112'yi ara." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The request is saved on the phone first; without a connection it's sent automatically once connected. Retfast is not an emergency service: in an emergency call 112."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talep önce telefona kaydedilir; bağlantı yoksa bağlantı gelince otomatik gönderilir. Retfast bir acil durum servisi değildir: acil durumda 112'yi ara."
          }
        }
      }
    },
