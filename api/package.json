{
  "name": "retfast-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/db/migrations && cp src/db/migrations/*.sql dist/db/migrations/",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:production": "node dist/db/migrate.js",
    "import:firebase": "tsx src/db/import-firebase.ts",
    "import:firebase:production": "node dist/db/import-firebase.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'dist/**'",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "pino-http": "^10.5.0",
    "ws": "^8.18.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.3",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "vitest": "^4.1.0"
  }
}
