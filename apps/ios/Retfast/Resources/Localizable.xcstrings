    },
    "Konum izni olmadan uçuş kaydı başlatılamaz.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A flight can't be recorded without location permission."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum izni olmadan uçuş kaydı başlatılamaz."
          }
        }
      }
    },
    "Konum izni reddedildi. Uçuş kaydı için Ayarlar'dan izin verin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location permission denied. Allow it in Settings to record flights."
