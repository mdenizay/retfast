rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return signedIn() && request.auth.token.superadmin == true;
    }

    function eventDocument(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId));
    }

    function isEventManager(eventId) {
      return isSuperAdmin()
        || (signedIn()
          && request.auth.uid in eventDocument(eventId).data.managerIds);
    }

    function hasEventMembership(eventId) {
      return signedIn()
        && exists(/databases/$(database)/documents/eventMemberships/$(eventId + '_' + request.auth.uid));
    }

    function isPublicEvent(eventData) {
      return eventData.visibility == 'public'
        && eventData.status in ['published', 'active', 'completed'];
    }

    function validOwnProfile(userId) {
      return request.resource.data.id == userId
        && request.resource.data.globalRole == 'user'
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.locale in ['tr', 'en']
        && (request.resource.data.radioCallsign == null
          || request.resource.data.radioCallsign is string);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'id',
          'email',
          'displayName',
          'locale',
          'globalRole',
          'radioCallsign',
          'createdAt',
          'updatedAt'
        ])
        && validOwnProfile(userId);

      allow update: if isSuperAdmin()
        || (isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName',
            'locale',
            'radioCallsign',
            'updatedAt'
          ])
          && request.resource.data.id == resource.data.id
          && request.resource.data.email == resource.data.email
          && request.resource.data.globalRole == resource.data.globalRole
          && validOwnProfile(userId));

      allow delete: if isSuperAdmin();
    }

    match /events/{eventId} {
      allow read: if isSuperAdmin()
        || (signedIn() && request.auth.uid in resource.data.managerIds)
        || hasEventMembership(eventId)
        || isPublicEvent(resource.data);
      allow create, update, delete: if false;
    }

    match /eventMemberships/{membershipId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid
          || isEventManager(resource.data.eventId));
      allow create, update, delete: if false;
    }

    match /auditLogs/{auditId} {
      allow read: if isSuperAdmin()
        || (signedIn() && isEventManager(resource.data.eventId));
      allow create, update, delete: if false;
    }

    match /trackingSessions/{sessionId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid
          || isEventManager(resource.data.eventId));
      allow create, update, delete: if false;

      match /chunks/{chunkId} {
        allow read: if signedIn()
          && (get(/databases/$(database)/documents/trackingSessions/$(sessionId)).data.userId == request.auth.uid
            || isEventManager(get(/databases/$(database)/documents/trackingSessions/$(sessionId)).data.eventId));
        allow create, update, delete: if false;
      }
    }

    match /trackingActives/{activeId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
