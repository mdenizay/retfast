    "Değerler GPS'ten hesaplanır. İrtifa GPS irtifasıdır; dikey hız filtrelenmiş bir tahmindir ve variometre yerine geçmez.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Values are computed from GPS. Altitude is GPS altitude; vertical speed is a filtered estimate and does not replace a variometer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değerler GPS'ten hesaplanır. İrtifa GPS irtifasıdır; dikey hız filtrelenmiş bir tahmindir ve variometre yerine geçmez."
          }
        }
      }
    },
