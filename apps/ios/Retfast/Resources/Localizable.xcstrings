    "Açıkken adınız, kanadınız ve herkese açık uçuşlarınız profil sayfanızda görünür. İletişim, lisans ve acil durum bilgileri asla gösterilmez.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, your name, wing and public flights appear on your profile page. Contact, licence and emergency details are never shown."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açıkken adınız, kanadınız ve herkese açık uçuşlarınız profil sayfanızda görünür. İletişim, lisans ve acil durum bilgileri asla gösterilmez."
          }
        }
      }
    },
