    "Retfast" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retfast"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retfast"
          }
        }
      },
      "shouldTranslate" : false
    },
    "Retfast bir acil durum servisi değildir ve kimseye otomatik haber vermez. Mümkünse etkinlik organizatörünü de ara." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retfast is not an emergency service and doesn't alert anyone automatically. If you can, call the event organizer too."
          }
        }
      }
    },
    "Retfast bir acil durum servisi değildir. Acil bir durumda 112'yi ara." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retfast is not an emergency service. In an emergency call 112."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retfast bir acil durum servisi değildir. Acil bir durumda 112'yi ara."
          }
        }
      }
    },
    "Retfast nedir?" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What is Retfast?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retfast nedir?"
          }
        }
      }
    },
    "Retfast SOS, çağrınızı internet üzerinden Retfast sunucusuna iletir. Yetkililere veya 112'ye otomatik olarak ulaşmaz ve acil servislerin yerini tutmaz. Bağlantı yoksa çağrı iletilemez; uygulama çağrının hangi aşamada olduğunu açıkça gösterir. Mümkünse her zaman 112'yi arayın." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retfast SOS sends your call to the Retfast server over the internet. It does not automatically reach the authorities or 112 and does not replace emergency services. Without a connection the call cannot be delivered; the app clearly shows which stage the call is at. Whenever possible, call 112."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retfast SOS, çağrınızı internet üzerinden Retfast sunucusuna iletir. Yetkililere veya 112'ye otomatik olarak ulaşmaz ve acil servislerin yerini tutmaz. Bağlantı yoksa çağrı iletilemez; uygulama çağrının hangi aşamada olduğunu açıkça gösterir. Mümkünse her zaman 112'yi arayın."
          }
        }
      }
    },
    "Retfast yamaç paraşütü etkinlikleri için uçuş takibi ve retrieve uygulamasıdır. Uçuşun canlı haritada görünür; indiğinde seni alacak retriever'ı tek dokunuşla çağırırsın." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retfast is flight tracking and retrieve for paragliding events. Your flight shows on the live map; when you land, one tap calls the retriever who picks you up."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retfast yamaç paraşütü etkinlikleri için uçuş takibi ve retrieve uygulamasıdır. Uçuşun canlı haritada görünür; indiğinde seni alacak retriever'ı tek dokunuşla çağırırsın."
          }
        }
      }
    },
    "Retfast yamaç paraşütü uçuşlarınızı GPS ile kaydeder, katıldığınız organizasyonun canlı haritasında paylaşır ve acil durumda konumunuzu kurtarma ekibine iletmeye çalışır." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retfast records your paragliding flights with GPS, shares them on the live map of the event you join, and in an emergency tries to deliver your position to the rescue team."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retfast yamaç paraşütü uçuşlarınızı GPS ile kaydeder, katıldığınız organizasyonun canlı haritasında paylaşır ve acil durumda konumunuzu kurtarma ekibine iletmeye çalışır."
          }
        }
      }
    },
    "Retfast yetkililere veya 112'ye ulaşmaz. Yaralanma veya tehlike durumunda her zaman 112'yi ve normal acil durum kanallarını kullan." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retfast does not contact authorities or 112. In case of injury or danger always use 112 and normal emergency channels."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retfast yetkililere veya 112'ye ulaşmaz. Yaralanma veya tehlike durumunda her zaman 112'yi ve normal acil durum kanallarını kullan."
          }
        }
      }
    },
    "Retfast'in acil servislerin yerini tutmadığını ve bağlantı olmadan çağrı iletemeyeceğini anladım." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I understand that Retfast does not replace emergency services and cannot deliver a call without a connection."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retfast'in acil servislerin yerini tutmadığını ve bağlantı olmadan çağrı iletemeyeceğini anladım."
          }
        }
      }
    },
    "Retfast'in bir acil durum servisi olmadığını; acil durumda 112'yi aramam gerektiğini anladım." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
