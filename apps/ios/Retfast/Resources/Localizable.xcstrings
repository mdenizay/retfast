    },
    "Konum izni: Her Zaman. Ekran kilitliyken kayıt sürer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location permission: Always. Recording continues while the screen is locked."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum izni: Her Zaman. Ekran kilitliyken kayıt sürer."
          }
        }
      }
    },
    "Konum izni: Kullanımdayken. Kayıt başlatıldıktan sonra arka planda sürer, ancak \"Her Zaman\" izni iOS kesintilerinden sonra kaydın kendiliğinden devam etmesini sağlar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location permission: While Using. Recording continues in the background once started, but \"Always\" lets recording resume by itself after iOS interruptions."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum izni: Kullanımdayken. Kayıt başlatıldıktan sonra arka planda sürer, ancak \"Her Zaman\" izni iOS kesintilerinden sonra kaydın kendiliğinden devam etmesini sağlar."
          }
        }
      }
