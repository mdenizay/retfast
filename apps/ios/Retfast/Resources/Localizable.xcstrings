    "Bağlantı sınırları": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectivity limits"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı sınırları"
          }
        }
      }
    },
    "Bağlantı yok": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No connection"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı yok"
          }
        }
      }
    },
    "Bağlantı yok. Kayıt çevrimdışı yapılır; canlı haritada görünmezsiniz ve acil durum çağrısı bağlantı gelene kadar iletilemez.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No connection. Recording works offline; you won't appear on the live map and an emergency call can't be delivered until a connection returns."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı yok. Kayıt çevrimdışı yapılır; canlı haritada görünmezsiniz ve acil durum çağrısı bağlantı gelene kadar iletilemez."
          }
        }
      }
    },
    "Bağlantı yok. Çağrı telefona kaydedilir ve bağlantı gelince otomatik gönderilir. Şu an kimseye ulaşmaz.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No connection. The call is saved on the phone and sent automatically when a connection returns. Right now it reaches no one."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı yok. Çağrı telefona kaydedilir ve bağlantı gelince otomatik gönderilir. Şu an kimseye ulaşmaz."
          }
        }
      }
    },
    "Bağlantı yokken de kayıt yapılır; veriler telefonda saklanır ve bağlantı gelince gönderilir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording works without a connection; data is stored on the phone and sent when a connection returns."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı yokken de kayıt yapılır; veriler telefonda saklanır ve bağlantı gelince gönderilir."
          }
        }
      }
    },
    "Bağlanıyor": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlanıyor"
          }
        }
      }
    },
    "Bağlı": {
      "localizations": {
        "en": {
          "stringUnit": {
