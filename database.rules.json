{
  "rules": {
    ".read": false,
    ".write": false,
    "eventAccess": {
      "$eventId": {
        "$userId": {
          ".read": "auth != null && (auth.uid === $userId || root.child('eventAccess').child($eventId).child(auth.uid).child('status').val() === 'approved')",
          ".write": false
        }
      }
    },
    "live": {
      "$eventId": {
        ".read": "auth != null && root.child('eventAccess').child($eventId).child(auth.uid).child('status').val() === 'approved'",
        "$userId": {
          ".write": "auth != null && auth.uid === $userId && root.child('eventAccess').child($eventId).child(auth.uid).child('status').val() === 'approved'",
          ".validate": "newData.hasChildren(['sessionId', 'userId', 'role', 'displayName', 'latitude', 'longitude', 'recordedAt', 'receivedAt', 'online', 'connectivity']) && newData.child('userId').val() === auth.uid && newData.child('role').val() === root.child('eventAccess').child($eventId).child(auth.uid).child('role').val()",
          "sessionId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128" },
          "userId": { ".validate": "newData.val() === auth.uid" },
          "role": { ".validate": "newData.val() === 'pilot' || newData.val() === 'retriever'" },
          "displayName": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 80" },
          "radioCallsign": { ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 24)" },
          "latitude": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
          "longitude": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
          "accuracy": { ".validate": "newData.val() === null || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000)" },
          "altitude": { ".validate": "newData.val() === null || (newData.isNumber() && newData.val() >= -1000 && newData.val() <= 20000)" },
          "speed": { ".validate": "newData.val() === null || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 200)" },
          "heading": { ".validate": "newData.val() === null || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 360)" },
          "batteryLevel": { ".validate": "newData.val() === null || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 1)" },
          "isCharging": { ".validate": "newData.val() === null || newData.isBoolean()" },
          "connectivity": { ".validate": "newData.val() === 'online' || newData.val() === 'limited' || newData.val() === 'offline' || newData.val() === 'unknown'" },
          "recordedAt": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 300000" },
          "receivedAt": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
          "online": { ".validate": "newData.isBoolean()" },
          "lastDisconnectedAt": { ".validate": "newData.val() === null || newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
