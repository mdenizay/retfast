# Use an URL-safe, randomly generated password (letters and digits only).
POSTGRES_DB=retfast
POSTGRES_USER=retfast
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://retfast:replace-with-the-same-password@postgres:5432/retfast

# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > Docker token.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

FIREBASE_PROJECT_ID=retfast-ab7ca
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
SUPERADMIN_EMAILS=medenizay@gmail.com
CORS_ORIGINS=https://retfast.com,https://www.retfast.com
LOG_LEVEL=info
