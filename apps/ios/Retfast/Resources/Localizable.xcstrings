    "DEMO": {
      "shouldTranslate": false
    },
    "Dağda mobil veri olmayabilir. Bağlantı yokken kayıt devam eder ama canlı haritada görünmezsiniz; veriler bağlantı gelince gönderilir. Uygulama durumu her zaman \"senkronize\", \"bekleyen\" veya \"çevrimdışı\" olarak gösterir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There may be no mobile data in the mountains. Without a connection recording continues but you won't appear on the live map; data is sent when a connection returns. The app always shows the state as \"synced\", \"pending\" or \"offline\"."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dağda mobil veri olmayabilir. Bağlantı yokken kayıt devam eder ama canlı haritada görünmezsiniz; veriler bağlantı gelince gönderilir. Uygulama durumu her zaman \"senkronize\", \"bekleyen\" veya \"çevrimdışı\" olarak gösterir."
          }
        }
      }
    },
