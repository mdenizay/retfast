        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu filtreye uyan etkinlik yok."
          }
        }
      }
    },
    "Bu işlem için kurtarma yetkiniz yok. Yetki sunucu tarafından belirlenir; gerekiyorsa platform yöneticisiyle iletişime geçin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have rescue permission for this action. Permissions are set by the server; contact a platform administrator if needed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem için kurtarma yetkiniz yok. Yetki sunucu tarafından belirlenir; gerekiyorsa platform yöneticisiyle iletişime geçin."
          }
        }
      }
    },
    "Bu işlem için yetkiniz yok.": {
